<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>الكرة السحرية — اكتشف شخصيتك</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Tahoma,Arial,sans-serif;
 background:#080b12;
 color:#eee;
 min-height:100vh;
}

button,input{font:inherit}

.topbar{
 height:65px;
 padding:0 18px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 border-bottom:1px solid #202638;
 background:#0d111b;
}

.logo{
 font-weight:bold;
 color:#bda7ff;
}

.sound{
 background:#151b29;
 color:#ddd;
 border:1px solid #30384d;
 padding:8px 13px;
 border-radius:10px;
 cursor:pointer;
}

.screen{
 display:none;
 min-height:calc(100vh - 65px);
 padding:25px 15px;
}

.screen.active{
 display:flex;
}

.container{
 width:100%;
 max-width:850px;
 margin:auto;
}

.card{
 background:#101522;
 border:1px solid #252d40;
 border-radius:22px;
 padding:28px;
 box-shadow:0 15px 50px #0008;
}

h1{
 margin-top:0;
 font-size:32px;
}

.sub{
 color:#929bb0;
 line-height:1.8;
}

.magic{
 width:180px;
 height:180px;
 margin:15px auto 25px;
 border-radius:50%;
 position:relative;
 display:flex;
 align-items:center;
 justify-content:center;
 background:
 radial-gradient(circle at 35% 30%,
 #fff 0 2%,
 #cfc1ff 4%,
 #8068db 18%,
 #30245f 48%,
 #100c25 75%);
 box-shadow:
 0 0 25px #8068db,
 0 0 70px #6045bd55,
 inset -20px -20px 35px #0008;
}

.magic:after{
 content:"✦";
 font-size:55px;
 color:#fff;
 text-shadow:0 0 20px #fff;
}

.speech{
 background:#171e2d;
 border:1px solid #303a52;
 border-radius:15px;
 padding:18px;
 margin:20px 0;
 line-height:1.8;
}

input{
 width:100%;
 padding:15px;
 background:#0b0f18;
 border:1px solid #30384d;
 color:white;
 border-radius:12px;
 outline:none;
 margin:10px 0 15px;
}

.btn{
 width:100%;
 border:0;
 padding:15px;
 border-radius:12px;
 background:#7559d9;
 color:white;
 cursor:pointer;
 font-weight:bold;
 transition:.15s;
}

.btn:hover{
 filter:brightness(1.15);
}

.btn:active{
 transform:scale(.98);
}

.ad-slot{
 margin:22px 0;
 min-height:90px;
 border:1px dashed #343c50;
 border-radius:12px;
 display:flex;
 align-items:center;
 justify-content:center;
 color:#626b7f;
 font-size:12px;
}

.quiz-head{
 display:flex;
 justify-content:space-between;
 color:#929bb0;
 margin-bottom:10px;
}

.progress{
 height:7px;
 background:#202638;
 border-radius:20px;
 overflow:hidden;
 margin-bottom:25px;
}

.progress-bar{
 height:100%;
 width:0%;
 background:#8b72e8;
 transition:.25s;
}

.question{
 font-size:24px;
 line-height:1.6;
 margin:25px 0;
}

.answers{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
}

.answer{
 padding:19px;
 min-height:80px;
 border:1px solid #30384d;
 background:#151b29;
 color:#eee;
 border-radius:13px;
 cursor:pointer;
 transition:.15s;
 line-height:1.7;
 text-align:right;
}

.answer:hover{
 background:#1d2536;
 border-color:#7565a9;
}

.answer:active{
 transform:scale(.98);
}

.result-icon{
 font-size:65px;
 text-align:center;
 margin:10px;
}

.result-title{
 text-align:center;
 font-size:30px;
 margin:10px 0;
}

.result-text{
 text-align:center;
 color:#aab2c2;
 line-height:2;
}

.score{
 text-align:center;
 margin:20px 0;
 color:#bda7ff;
 font-size:18px;
}

.modal{
 display:none;
 position:fixed;
 inset:0;
 background:#000b;
 align-items:center;
 justify-content:center;
 padding:20px;
}

.modal.show{
 display:flex;
}

.modal-box{
 max-width:600px;
 background:#101522;
 border:1px solid #30384d;
 border-radius:18px;
 padding:25px;
 line-height:1.9;
}

@media(max-width:600px){

 .card{
  padding:20px;
 }

 h1{
  font-size:25px;
 }

 .magic{
  width:145px;
  height:145px;
 }

 .question{
  font-size:20px;
 }

 .answers{
  grid-template-columns:1fr;
 }

 .answer{
  min-height:auto;
  padding:16px;
 }
}
</style>
</head>

<body>

<div class="topbar">
 <div class="logo">✦ الكرة السحرية</div>

 <button class="sound" id="soundBtn">
  🔊 الصوت
 </button>
</div>


<!-- البداية -->

<section class="screen active" id="start">

 <div class="container">

  <div class="card">

   <div class="magic"></div>

   <h1 style="text-align:center">
    الكرة السحرية
   </h1>

   <div class="speech" style="text-align:center">

    أهلاً بيك...<br>

    جاوب على 24 سؤال، وأنا هحاول أكتشف شخصيتك.

   </div>

   <input
    id="nameInput"
    placeholder="اكتب اسمك"
   >

   <button class="btn" onclick="startGame()">
    ابدأ الاختبار
   </button>

   <div class="ad-slot">
    ADVERTISEMENT
   </div>

   <button
    class="btn"
    style="background:#202638"
    onclick="showPrivacy()"
   >
    سياسة الخصوصية
   </button>

  </div>

 </div>

</section>


<!-- الأسئلة -->

<section class="screen" id="quiz">

 <div class="container">

  <div class="card">

   <div class="quiz-head">

    <span id="questionNumber">
     السؤال 1 من 24
    </span>

    <span id="playerLabel"></span>

   </div>

   <div class="progress">

    <div
     class="progress-bar"
     id="progressBar"
    ></div>

   </div>

   <div
    class="magic"
    style="width:120px;height:120px;margin:15px auto"
   ></div>

   <div class="speech">
    الكرة السحرية بتسألك...
   </div>

   <div
    class="question"
    id="questionText"
   ></div>

   <div
    class="answers"
    id="answers"
   ></div>

   <div class="ad-slot">
    ADVERTISEMENT
   </div>

  </div>

 </div>

</section>


<!-- النتيجة -->

<section class="screen" id="result">

 <div class="container">

  <div class="card">

   <div class="magic"></div>

   <div
    class="result-icon"
    id="resultIcon"
   >
    ✦
   </div>

   <div
    class="result-title"
    id="resultTitle"
   ></div>

   <div
    class="result-text"
    id="resultText"
   ></div>

   <div
    class="score"
    id="score"
   ></div>

   <button
    class="btn"
    onclick="restartGame()"
   >
    اختبار جديد
   </button>

   <div class="ad-slot">
    ADVERTISEMENT
   </div>

   <button
    class="btn"
    style="background:#202638"
    onclick="showPrivacy()"
   >
    سياسة الخصوصية
   </button>

  </div>

 </div>

</section>


<!-- الخصوصية -->

<div
 class="modal"
 id="privacyModal"
>

 <div class="modal-box">

