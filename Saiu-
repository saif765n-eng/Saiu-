  text:"الناس والعلاقات جزء مهم من شخصيتك، وبتحب التواصل ومشاركة اللي حواليك."
 },

 creative:{
  title:"العقل المبدع",
  icon:"◇",
  text:"عندك طريقة مختلفة في التفكير، وبتحب الأفكار الجديدة وتجربة طرق مش تقليدية."
 }

};


let current=0;
let player="";

let scores={
 calm:0,
 bold:0,
 social:0,
 creative:0
};


let audioCtx=null;
let sound=true;
let musicTimer=null;


function audio(){

 if(!audioCtx)
  audioCtx=
   new (window.AudioContext||window.webkitAudioContext)();

}


function tone(
 freq,
 duration=.08,
 type="sine",
 volume=.035
){

 if(!sound)return;

 audio();

 const o=
  audioCtx.createOscillator();

 const g=
  audioCtx.createGain();

 o.type=type;

 o.frequency.value=freq;

 g.gain.setValueAtTime(
  volume,
  audioCtx.currentTime
 );

 g.gain.exponentialRampToValueAtTime(
  .001,
  audioCtx.currentTime+duration
 );

 o.connect(g);
 g.connect(audioCtx.destination);

 o.start();

 o.stop(
  audioCtx.currentTime+duration
 );

}


function clickSound(){

 tone(
  420,
  .06,
  "sine",
  .025
 );

}


function nextSound(){

 tone(
  520,
  .07,
  "sine",
  .025
 );

 setTimeout(
  ()=>tone(
   680,
   .08,
   "sine",
   .02
  ),
  60
 );

}


function resultSound(){

 tone(
  392,
  .15,
  "sine",
  .03
 );

 setTimeout(
  ()=>tone(
   523,
   .18,
   "sine",
   .025
  ),
  120
 );

 setTimeout(
  ()=>tone(
   659,
   .25,
   "sine",
   .02
  ),
  250
 );

}


function startMusic(){

 if(!sound || musicTimer)return;

 audio();

 const notes=[
  261.63,
  329.63,
  392,
  329.63,
  293.66,
  349.23,
  440,
  349.23
 ];

 let i=0;

 musicTimer=setInterval(()=>{

  tone(
   notes[i%notes.length],
   .55,
   "sine",
   .008
  );

  i++;

 },650);

}


function stopMusic(){

 if(musicTimer){

  clearInterval(musicTimer);

  musicTimer=null;

 }

}


function toggleSound(){

 sound=!sound;

 document.getElementById(
  "soundBtn"
 ).textContent=
  sound
   ? "🔊 الصوت"
   : "🔇 الصوت";

 if(sound)
  startMusic();
 else
  stopMusic();

}


document.getElementById(
 "soundBtn"
).onclick=toggleSound;


function showScreen(id){

 document
  .querySelectorAll(".screen")
  .forEach(
   x=>x.classList.remove("active")
  );

 document
  .getElementById(id)
  .classList.add("active");

 window.scrollTo(0,0);
}


function startGame(){

 player=
  document
   .getElementById("nameInput")
   .value
   .trim();

 if(!player){

  document
   .getElementById("nameInput")
   .focus();

  return;

 }

 audio();

 if(
  audioCtx.state==="suspended"
 )
  audioCtx.resume();

 startMusic();

 current=0;

 scores={
  calm:0,
  bold:0,
  social:0,
  creative:0
 };

 document
  .getElementById("playerLabel")
  .textContent=
  player;

 showScreen("quiz");

 showQuestion();

}


function showQuestion(){

 const q=
  questions[current];

 document
  .getElementById("questionNumber")
  .textContent=
  `السؤال ${current+1} من ${questions.length}`;

 document
  .getElementById("progressBar")
  .style.width=
  ((current/questions.length)*100)+"%";

 document
  .getElementById("questionText")
  .textContent=
  q[0];

 const box=
  document.getElementById("answers");

 box.innerHTML="";

 q[1].forEach(
  (answer,i)=>{

   const b=
    document.createElement("button");

   b.className="answer";

   b.textContent=answer;

   b.onclick=
    ()=>chooseAnswer(q[2][i]);

   box.appendChild(b);

  }
 );

}


function chooseAnswer(type){

 clickSound();

 scores[type]++;

 current++;

 if(
  current<questions.length
 ){

  nextSound();

  showQuestion();

 }else{

  showResult();

 }

}


function showResult(){

 let winner="calm";

 Object
  .keys(scores)
  .forEach(type=>{

   if(
    scores[type]>scores[winner]
   )
    winner=type;

  });

 const p=
  profiles[winner];

 document
  .getElementById("resultIcon")
  .textContent=
  p.icon;

 document
  .getElementById("resultTitle")
  .textContent=
  `${player} — ${p.title}`;

 document
  .getElementById("resultText")
  .textContent=
  p.text;

 document
  .getElementById("score")
  .textContent=
  `أجبت ${scores[winner]} إجابات تميل لهذا النوع`;

 document
  .getElementById("progressBar")
  .style.width="100%";

 showScreen("result");

 resultSound();

}


function restartGame(){

 clickSound();

 stopMusic();

 showScreen("start");

 document
  .getElementById("nameInput")
  .value="";

}


function showPrivacy(){

 document
  .getElementById("privacyModal")
  .classList.add("show");

}


function closePrivacy(){

 document
  .getElementById("privacyModal")
  .classList.remove("show");

}


document
 .getElementById("privacyModal")
 .onclick=e=>{

  if(
   e.target.id==="privacyModal"
  )
   closePrivacy();

 };


document
 .getElementById("nameInput")
 .addEventListener(
  "keydown",
  e=>{

   if(e.key==="Enter")
    startGame();

  }
 );

</script>

</body>
</html>
